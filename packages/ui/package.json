{
  "name": "@vybora/ui",
  "version": "0.0.0",
  "private": true,
  "description": "VYBORA design tokens (colors, type, spacing, radii, motion). Platform-agnostic: consumed by the mobile NativeWind theme and the admin Tailwind theme.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vybora/config": "workspace:*",
    "typescript": "~5.9.3"
  }
}
