{
  "name": "@vybora/ui",
  "version": "0.0.0",
  "private": true,
  "description": "VYBORA design tokens (colors, type, spacing, radii, motion) and WCAG contrast helpers. Platform-agnostic: consumed by the mobile theme and the admin dashboard.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vybora/config": "workspace:*",
    "typescript": "~5.9.3"
  }
}
