// -----------------------------------------------------------------------------
// IDENTITY & AUTH
// -----------------------------------------------------------------------------

model User {
  id                  String        @id @default(uuid(7)) @db.Uuid
  /// Stored normalized (trimmed, lowercased). Unique when present.
  email               String?       @unique
  emailVerifiedAt     DateTime?
  /// E.164 format. Unique when present.
  phone               String?       @unique
  phoneVerifiedAt     DateTime?
  /// argon2id hash; null for social-only accounts.
  passwordHash        String?
  /// Lowercase; validated by @vybora/shared validateUsername.
  username            String        @unique
  displayName         String
  bio                 String?
  website             String?
  avatarMediaId       String?       @db.Uuid
  coverMediaId        String?       @db.Uuid
  isPrivate           Boolean       @default(false)
  isVerified          Boolean       @default(false)
  role                UserRole      @default(USER)
  status              AccountStatus @default(ACTIVE)
  suspendedUntil      DateTime?
  locale              String        @default("en")
  countryCode         String?       @db.Char(2)
  dateOfBirth         DateTime?     @db.Date
  followerCount       Int           @default(0)
  followingCount      Int           @default(0)
  postCount           Int           @default(0)
  /// Bumped on password change / "log out everywhere"; embedded in access JWT.
  tokenVersion        Int           @default(0)
  lastActiveAt        DateTime?
  deletionRequestedAt DateTime?
  /// Grace period end; purge job hard-deletes after this.
  deletionScheduledAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  avatar MediaAsset? @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  cover  MediaAsset? @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  verificationCodes VerificationCode[]
  pushTokens        PushToken[]
  settings          UserSettings?
  notificationPrefs NotificationPreference[]
  staff             StaffMember?
  interests         UserInterest[]

  following     Follow[]      @relation("Follower")
  followers     Follow[]      @relation("Following")
  blocking      Block[]       @relation("Blocker")
  blockedBy     Block[]       @relation("Blocked")
  restricting   Restrict[]    @relation("Restricter")
  restrictedBy  Restrict[]    @relation("Restricted")
  mutes         Mute[]        @relation("Muter")
  mutedBy       Mute[]        @relation("Muted")
  closeFriends  CloseFriend[] @relation("CloseFriendOwner")
  closeFriendOf CloseFriend[] @relation("CloseFriendMember")

  media           MediaAsset[]     @relation("MediaOwner")
  posts           Post[]
  postLikes       PostLike[]
  comments        Comment[]
  commentLikes    CommentLike[]
  savedPosts      SavedPost[]
  saveCollections SaveCollection[]
  postMentions    PostMention[]

  stories          Story[]
  storyViews       StoryView[]
  storyReactions   StoryReaction[]
  storyAudience    StoryAudienceMember[]
  stickerResponses StickerResponse[]
  highlights       Highlight[]

  conversationsMember ConversationMember[]
  conversationsMade   Conversation[]       @relation("ConversationCreator")
  messagesSent        Message[]            @relation("MessageSender")
  messageReactions    MessageReaction[]
  hiddenMessages      MessageHidden[]
  e2eeDevices         E2eeDevice[]

  artistProfile       Artist?
  artistFollows       ArtistFollow[]
  playlists           Playlist[]
  playlistCollabs     PlaylistCollaborator[]
  playlistTracksAdded PlaylistTrack[]

  communitiesOwned Community[]          @relation("CommunityOwner")
  communityMembers CommunityMember[]
  communityEvents  CommunityEvent[]
  eventRsvps       CommunityEventRsvp[]

  creatorProfile     CreatorProfile?
  subscriptions      CreatorSubscription[] @relation("Subscriber")
  paymentsMade       Payment[]             @relation("Payer")
  paymentsReceived   Payment[]             @relation("PaymentRecipient")
  giftsSent          GiftTransaction[]     @relation("GiftSender")
  giftsReceived      GiftTransaction[]     @relation("GiftRecipient")
  contentUnlocks     ContentUnlock[]
  promotions         Promotion[]
  brands             Brand[]
  collabApplications CollabApplication[]

  notifications      Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")

  reportsFiled        Report[]              @relation("Reporter")
  reportsAssigned     Report[]              @relation("ReportAssignee")
  moderationActions   ModerationAction[]    @relation("Moderator")
  moderationTargeted  ModerationAction[]    @relation("ModeratedUser")
  verificationReqs    VerificationRequest[] @relation("VerificationApplicant")
  verificationReviews VerificationRequest[] @relation("VerificationReviewer")
  payoutsReviewed     Payout[]              @relation("PayoutReviewer")

  aiJobs          AiJob[]
  calendarEntries ContentCalendarEntry[]
  dataExports     DataExportRequest[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  /// Stable subject ("sub") claim from the verified provider ID token.
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// One row per signed-in device. Listed in Settings → Security → Sessions.
model Session {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String          @db.Uuid
  deviceName String?
  platform   DevicePlatform?
  appVersion String?
  /// Coarse location for "new login" alerts (city/country), never raw IP.
  ipCountry  String?         @db.Char(2)
  ipHash     String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  lastSeenAt DateTime        @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Reuse of a rotated
/// token revokes the whole family (session) — standard theft detection.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now())

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// OTP / magic codes. Hashed, short-lived, attempt-limited.
model VerificationCode {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String?             @db.Uuid
  channel    VerificationChannel
  /// Normalized email or E.164 phone the code was sent to.
  target     String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_codes")
}

/// FCM / APNs (via FCM) registration tokens, tied to a session so logout removes them.
model PushToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  sessionId String?        @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model UserSettings {
  userId                 String          @id @db.Uuid
  allowMessagesFrom      AudienceSetting @default(EVERYONE)
  allowMentionsFrom      AudienceSetting @default(EVERYONE)
  allowTagsFrom          AudienceSetting @default(EVERYONE)
  allowStoryRepliesFrom  AudienceSetting @default(FOLLOWERS)
  showActivityStatus     Boolean         @default(true)
  showReadReceipts       Boolean         @default(true)
  hideLikeCounts         Boolean         @default(false)
  sensitiveContentFilter Boolean         @default(true)
  /// Explicit, revocable consent for location-based discovery (GDPR Art. 7).
  locationConsentAt      DateTime?
  personalizedAdsConsent Boolean         @default(false)
  analyticsConsent       Boolean         @default(true)
  /// Words/phrases auto-hidden from comments & message requests.
  hiddenWords            String[]        @default([])
  theme                  String          @default("system")
  updatedAt              DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model NotificationPreference {
  userId String           @db.Uuid
  type   NotificationType
  push   Boolean          @default(true)
  inApp  Boolean          @default(true)
  email  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// Admin dashboard access. RBAC permissions per role are defined in code
/// (apps/api/src/modules/admin/permissions.ts) so they are reviewed in PRs.
model StaffMember {
  userId    String      @id @db.Uuid
  roles     StaffRole[]
  mfaSecret String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_members")
}

// -----------------------------------------------------------------------------
// SOCIAL GRAPH
// -----------------------------------------------------------------------------

model Follow {
  followerId  String       @db.Uuid
  followingId String       @db.Uuid
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, status, createdAt])
  @@index([followerId, status, createdAt])
  @@map("follows")
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// "Restrict": restricted user's comments are visible only to themselves,
/// their DMs go to requests, and they cannot see your online status.
model Restrict {
  restricterId String   @db.Uuid
  restrictedId String   @db.Uuid
  createdAt    DateTime @default(now())

  restricter User @relation("Restricter", fields: [restricterId], references: [id], onDelete: Cascade)
  restricted User @relation("Restricted", fields: [restrictedId], references: [id], onDelete: Cascade)

  @@id([restricterId, restrictedId])
  @@map("restricts")
}

model Mute {
  muterId     String   @db.Uuid
  mutedId     String   @db.Uuid
  mutePosts   Boolean  @default(true)
  muteStories Boolean  @default(true)
  createdAt   DateTime @default(now())

  muter User @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@map("mutes")
}

model CloseFriend {
  ownerId   String   @db.Uuid
  friendId  String   @db.Uuid
  createdAt DateTime @default(now())

  owner  User @relation("CloseFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("CloseFriendMember", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([ownerId, friendId])
  @@map("close_friends")
}

model Interest {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String @unique
  name String

  users       UserInterest[]
  communities CommunityInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String @db.Uuid
  interestId String @db.Uuid
  weight     Float  @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

// -----------------------------------------------------------------------------
// MEDIA (S3-compatible storage; FFmpeg/sharp processing in workers)
// -----------------------------------------------------------------------------

model MediaAsset {
  id            String      @id @default(uuid(7)) @db.Uuid
  ownerId       String      @db.Uuid
  kind          MediaKind
  status        MediaStatus @default(PENDING_UPLOAD)
  /// Object key of the original upload (private bucket).
  storageKey    String      @unique
  mimeType      String
  sizeBytes     BigInt?
  width         Int?
  height        Int?
  durationMs    Int?
  /// Compact placeholder rendered while the real image loads.
  blurhash      String?
  sha256        String?
  /// Processed renditions: { "thumb": key, "720p": key, "hls": key, ... }
  variants      Json?
  /// True for client-side encrypted DM attachments (server cannot read them).
  isEncrypted   Boolean     @default(false)
  moderation    Json?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  owner            User           @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOf         User[]         @relation("UserAvatar")
  coverOf          User[]         @relation("UserCover")
  postItems        PostMedia[]
  stories          Story[]
  messages         Message[]
  highlights       Highlight[]
  communityAvatars Community[]    @relation("CommunityAvatar")
  communityCovers  Community[]    @relation("CommunityCover")
  playlists        Playlist[]
  tracks           Track[]
  aiInputs         AiJob[]        @relation("AiInputMedia")
  aiOutputs        AiJob[]        @relation("AiOutputMedia")
  conversations    Conversation[]

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("media_assets")
}

// -----------------------------------------------------------------------------
// POSTS & REELS (a reel is a Post with type = REEL — shared engagement stack)
// -----------------------------------------------------------------------------

model Place {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  latitude    Float
  longitude   Float
  /// Precision-6 geohash (~1.2km) for cheap proximity queries before PostGIS.
  geohash     String
  countryCode String? @db.Char(2)
  city        String?
  providerRef String?

  posts Post[]

  @@index([geohash])
  @@map("places")
}

model Post {
  id               String        @id @default(uuid(7)) @db.Uuid
  authorId         String        @db.Uuid
  type             PostType
  caption          String?
  visibility       Visibility    @default(PUBLIC)
  accessLevel      AccessLevel   @default(FREE)
  priceMinor       Int?
  currency         String?       @db.Char(3)
  status           ContentStatus @default(ACTIVE)
  communityId      String?       @db.Uuid
  isAnnouncement   Boolean       @default(false)
  isPinned         Boolean       @default(false)
  placeId          String?       @db.Uuid
  trackId          String?       @db.Uuid
  trackStartMs     Int?
  /// Duet / remix lineage — always credited to the original creator.
  remixOfId        String?       @db.Uuid
  duetOfId         String?       @db.Uuid
  allowRemix       Boolean       @default(true)
  commentsDisabled Boolean       @default(false)
  hideLikeCount    Boolean       @default(false)
  /// Auto-generated captions (WebVTT key in storage) for accessibility.
  subtitlesKey     String?
  language         String?
  likeCount        Int           @default(0)
  commentCount     Int           @default(0)
  shareCount       Int           @default(0)
  saveCount        Int           @default(0)
  viewCount        BigInt        @default(0)
  /// Precomputed ranking score (see documentation/architecture/RANKING.md).
  rankScore        Float         @default(0)
  publishedAt      DateTime      @default(now())
  scheduledFor     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  place     Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  track     Track?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  remixOf   Post?      @relation("Remix", fields: [remixOfId], references: [id], onDelete: SetNull)
  remixes   Post[]     @relation("Remix")
  duetOf    Post?      @relation("Duet", fields: [duetOfId], references: [id], onDelete: SetNull)
  duets     Post[]     @relation("Duet")

  media            PostMedia[]
  hashtags         PostHashtag[]
  mentions         PostMention[]
  likes            PostLike[]
  comments         Comment[]
  saves            SavedPost[]
  unlocks          ContentUnlock[]
  promotions       Promotion[]
  sharedInMessages Message[]
  gifts            GiftTransaction[]
  calendarEntries  ContentCalendarEntry[]

  @@index([authorId, publishedAt(sort: Desc)])
  @@index([type, status, publishedAt(sort: Desc)])
  @@index([type, status, rankScore(sort: Desc)])
  @@index([communityId, publishedAt(sort: Desc)])
  @@index([trackId])
  @@index([placeId])
  @@index([remixOfId])
  @@map("posts")
}

model PostMedia {
  postId   String  @db.Uuid
  mediaId  String  @db.Uuid
  position Int
  altText  String?
  /// Non-destructive edit params (crop, filter id, trim in/out) applied at render.
  edits    Json?

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, position])
  @@index([mediaId])
