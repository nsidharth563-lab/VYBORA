model Artist {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Linked VYBORA account when the artist has claimed their profile.
  userId        String?  @unique @db.Uuid
  name          String
  bio           String?
  imageUrl      String?
  isVerified    Boolean  @default(false)
  provider      String?
  providerRef   String?
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  tracks    Track[]
  followers ArtistFollow[]

  @@unique([provider, providerRef])
  @@map("artists")
}

model Track {
  id               String    @id @default(uuid(7)) @db.Uuid
  artistId         String    @db.Uuid
  title            String
  album            String?
  artworkUrl       String?
  durationMs       Int
  isrc             String?
  isExplicit       Boolean   @default(false)
  genre            String?
  /// Licensing source: "vybora_original" (uploaded by rights holder) or a licensed provider id.
  provider         String
  providerRef      String?
  /// Audio for original uploads; licensed providers stream from their CDN.
  audioMediaId     String?   @db.Uuid
  /// Licensed usage scope, e.g. { inReels: true, inStories: true, regions: ["IN","US"], clipMaxMs: 60000 }.
  license          Json
  licenseExpiresAt DateTime?
  hasLyrics        Boolean   @default(false)
  usageCount       Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  artist        Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  audio         MediaAsset?     @relation(fields: [audioMediaId], references: [id], onDelete: SetNull)
  posts         Post[]
  stories       Story[]
  playlistItems PlaylistTrack[]
  messageShares Message[]

  @@unique([provider, providerRef])
  @@index([artistId])
  @@index([isActive, usageCount(sort: Desc)])
  @@map("tracks")
}

model ArtistFollow {
  userId    String   @db.Uuid
  artistId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([artistId])
  @@map("artist_follows")
}

model Playlist {
  id              String             @id @default(uuid(7)) @db.Uuid
  ownerId         String             @db.Uuid
  title           String
  description     String?
  coverMediaId    String?            @db.Uuid
  visibility      PlaylistVisibility @default(PUBLIC)
  isCollaborative Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner         User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cover         MediaAsset?            @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  tracks        PlaylistTrack[]
  collaborators PlaylistCollaborator[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistTrack {
  playlistId String   @db.Uuid
  trackId    String   @db.Uuid
  addedById  String?  @db.Uuid
  /// Fractional index string (LexoRank-style) for cheap concurrent reordering.
  position   String
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([playlistId, trackId])
