  @@index([communityId, startsAt])
  @@map("community_events")
}

model CommunityEventRsvp {
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  status    RsvpStatus
  updatedAt DateTime   @updatedAt

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("community_event_rsvps")
}

// -----------------------------------------------------------------------------
// CREATOR MONETIZATION
// -----------------------------------------------------------------------------
// Money truth = provider webhooks → Payment.status → LedgerEntry (double entry).
// The mobile client never marks anything paid. Balances are SUM(ledger) per
// account; payouts debit CREATOR_AVAILABLE.
// -----------------------------------------------------------------------------

model CreatorProfile {
  userId               String           @id @db.Uuid
  status               CreatorStatus    @default(APPLIED)
  kycStatus            KycStatus        @default(NOT_STARTED)
  payoutProvider       PaymentProvider?
  /// Stripe Connect account id (acct_…) or Razorpay Route linked account id.
  payoutAccountId      String?          @unique
  country              String           @db.Char(2)
  defaultCurrency      String           @db.Char(3)
  subscriptionsEnabled Boolean          @default(false)
  tipsEnabled          Boolean          @default(true)
  giftsEnabled         Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers       SubscriptionTier[]
  subscribers CreatorSubscription[]
  payouts     Payout[]

  @@map("creator_profiles")
}

model SubscriptionTier {
  id              String          @id @default(uuid(7)) @db.Uuid
  creatorId       String          @db.Uuid
  name            String
  description     String?
  benefits        String[]        @default([])
  priceMinor      Int
  currency        String          @db.Char(3)
  interval        BillingInterval @default(MONTH)
  providerPriceId String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  creator       CreatorProfile        @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  subscriptions CreatorSubscription[]

  @@index([creatorId, isActive])
  @@map("subscription_tiers")
}

model CreatorSubscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  subscriberId           String             @db.Uuid
  creatorId              String             @db.Uuid
  tierId                 String             @db.Uuid
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               PaymentProvider
  providerSubscriptionId String             @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  subscriber User             @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    CreatorProfile   @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  tier       SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([subscriberId, creatorId, status])
  @@index([creatorId, status])
  @@map("creator_subscriptions")
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  payerId           String?         @db.Uuid
  recipientId       String?         @db.Uuid
  kind              PaymentKind
  provider          PaymentProvider
  /// PaymentIntent id (pi_…) / Razorpay order or payment id.
  providerPaymentId String          @unique
  amountMinor       Int
  currency          String          @db.Char(3)
  platformFeeMinor  Int             @default(0)
  providerFeeMinor  Int?
  status            PaymentStatus   @default(PENDING)
  subscriptionId    String?         @db.Uuid
  /// Client-supplied idempotency key for the create call.
  idempotencyKey    String          @unique
  metadata          Json?
  succeededAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  payer        User?                @relation("Payer", fields: [payerId], references: [id], onDelete: SetNull)
  recipient    User?                @relation("PaymentRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  subscription CreatorSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  ledger       LedgerEntry[]
  gift         GiftTransaction?
  unlock       ContentUnlock?
  promotion    Promotion?

  @@index([payerId, createdAt])
  @@index([recipientId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every provider webhook is stored first, verified, then processed exactly once.
model WebhookEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json
  signatureOk Boolean
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  error       String?

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

model LedgerAccount {
  id          String            @id @default(uuid(7)) @db.Uuid
  type        LedgerAccountType
  /// Null for platform-level accounts.
  ownerUserId String?           @db.Uuid
  currency    String            @db.Char(3)
  createdAt   DateTime          @default(now())

  entries LedgerEntry[]

  @@unique([type, ownerUserId, currency])
  @@map("ledger_accounts")
}

/// Immutable. Each transactionId's DEBITs and CREDITs must sum equal (enforced in service; a deferred-constraint DB trigger is added in Phase 15).
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  transactionId String          @db.Uuid
  accountId     String          @db.Uuid
  direction     LedgerDirection
  amountMinor   Int
  currency      String          @db.Char(3)
  paymentId     String?         @db.Uuid
  payoutId      String?         @db.Uuid
  description   String
  /// Funds in CREATOR_PENDING move to AVAILABLE after this (refund window).
  availableAt   DateTime?
  createdAt     DateTime        @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payout  Payout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model VirtualGift {
  id           String  @id @default(uuid(7)) @db.Uuid
  name         String
  iconUrl      String
  animationUrl String?
  priceMinor   Int
  currency     String  @db.Char(3)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  transactions GiftTransaction[]

  @@map("virtual_gifts")
}

model GiftTransaction {
  id          String   @id @default(uuid(7)) @db.Uuid
  giftId      String   @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  paymentId   String   @unique @db.Uuid
  postId      String?  @db.Uuid
  message     String?
  createdAt   DateTime @default(now())

  gift      VirtualGift @relation(fields: [giftId], references: [id], onDelete: Restrict)
  sender    User        @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User        @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  payment   Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  post      Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@map("gift_transactions")
}

model ContentUnlock {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  paymentId String   @unique @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@id([userId, postId])
  @@map("content_unlocks")
}

model Payout {
  id               String          @id @default(uuid(7)) @db.Uuid
  creatorId        String          @db.Uuid
  amountMinor      Int
  currency         String          @db.Char(3)
  status           PayoutStatus    @default(REQUESTED)
  provider         PaymentProvider
  providerPayoutId String?         @unique
  reviewedById     String?         @db.Uuid
  reviewNote       String?
  failureReason    String?
  requestedAt      DateTime        @default(now())
  completedAt      DateTime?

  creator    CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Restrict)
  reviewedBy User?          @relation("PayoutReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  ledger     LedgerEntry[]

  @@index([creatorId, requestedAt])
  @@index([status])
  @@map("payouts")
}

model Promotion {
  id          String          @id @default(uuid(7)) @db.Uuid
  postId      String          @db.Uuid
  buyerId     String          @db.Uuid
  paymentId   String?         @unique @db.Uuid
  budgetMinor Int
  spentMinor  Int             @default(0)
  currency    String          @db.Char(3)
  /// { countries[], ageMin, ageMax, interests[] } — no sensitive categories.
  targeting   Json
  status      PromotionStatus @default(DRAFT)
  impressions Int             @default(0)
  clicks      Int             @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@map("promotions")
}

model Brand {
  id         String   @id @default(uuid(7)) @db.Uuid
  ownerId    String   @db.Uuid
  name       String
  website    String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings CollabListing[]

  @@map("brands")
}

model CollabListing {
  id             String       @id @default(uuid(7)) @db.Uuid
  brandId        String       @db.Uuid
  title          String
  description    String
  budgetMinMinor Int?
  budgetMaxMinor Int?
  currency       String?      @db.Char(3)
  requirements   Json?
  status         CollabStatus @default(OPEN)
  closesAt       DateTime?
  createdAt      DateTime     @default(now())

  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications CollabApplication[]

  @@index([status, createdAt])
  @@map("collab_listings")
}

model CollabApplication {
  id        String            @id @default(uuid(7)) @db.Uuid
  listingId String            @db.Uuid
  creatorId String            @db.Uuid
  pitch     String
  status    ApplicationStatus @default(SUBMITTED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  listing CollabListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  creator User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([listingId, creatorId])
  @@map("collab_applications")
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------------

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  recipientId String           @db.Uuid
  actorId     String?          @db.Uuid
  type        NotificationType
  /// Polymorphic pointer, e.g. ("post", id). Resolved & permission-checked on read.
  entityType  String?
  entityId    String?          @db.Uuid
  /// Aggregation key: "LIKE:post:<id>" collapses "Ana and 23 others liked…".
  groupKey    String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@index([recipientId, groupKey])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// TRUST, SAFETY & ADMIN
// -----------------------------------------------------------------------------

model Report {
  id           String           @id @default(uuid(7)) @db.Uuid
  reporterId   String?          @db.Uuid
  targetType   ReportTargetType
  targetId     String           @db.Uuid
  /// Owner of the reported content (for repeat-offender queries).
  targetUserId String?          @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  /// Higher = reviewed sooner (CHILD_SAFETY/SELF_HARM are always max).
  priority     Int              @default(0)
  assignedToId String?          @db.Uuid
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  reporter   User?              @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo User?              @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  actions    ModerationAction[]

  @@index([status, priority(sort: Desc), createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@map("reports")
}

model ModerationAction {
  id           String               @id @default(uuid(7)) @db.Uuid
  moderatorId  String?              @db.Uuid
  action       ModerationActionType
  targetType   ReportTargetType
  targetId     String               @db.Uuid
  targetUserId String?              @db.Uuid
  reportId     String?              @db.Uuid
  reason       String
  /// Automated actions (spam classifier etc.) have moderatorId = null.
  isAutomated  Boolean              @default(false)
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())

  moderator  User?   @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)
  targetUser User?   @relation("ModeratedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  report     Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([targetType, targetId])
  @@map("moderation_actions")
}

model VerificationRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @db.Uuid
  category     String
  /// Private-bucket object keys of supporting documents; purged after review.
  documentKeys String[]     @default([])
  links        String[]     @default([])
  status       ReviewStatus @default(PENDING)
  reviewedById String?      @db.Uuid
  reviewNote   String?
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  user       User  @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("verification_requests")
}

/// Append-only. Written for every privileged action (admin, payments, auth events).
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String
  entityType String?
  entityId   String?
  ipHash     String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// AI STUDIO
// -----------------------------------------------------------------------------

model AiJob {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  kind          AiJobKind
  status        JobStatus @default(QUEUED)
  /// Provider adapter used (e.g. "openai") — swappable behind AiProvider interface.
  provider      String
  model         String?
  input         Json
  output        Json?
  inputMediaId  String?   @db.Uuid
  outputMediaId String?   @db.Uuid
  inputTokens   Int?
  outputTokens  Int?
  /// Cost in micro-USD for quota & margin tracking.
  costMicros    Int?
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputMedia  MediaAsset? @relation("AiInputMedia", fields: [inputMediaId], references: [id], onDelete: SetNull)
  outputMedia MediaAsset? @relation("AiOutputMedia", fields: [outputMediaId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_jobs")
}

model ContentCalendarEntry {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String              @db.Uuid
  title       String
  notes       String?
  format      PostType?
  plannedFor  DateTime
  status      CalendarEntryStatus @default(IDEA)
  postId      String?             @db.Uuid
  aiGenerated Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, plannedFor])
  @@map("content_calendar_entries")
}

// -----------------------------------------------------------------------------
// PRIVACY / GDPR
// -----------------------------------------------------------------------------

model DataExportRequest {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  status      JobStatus @default(QUEUED)
  /// Private-bucket key of the generated ZIP; served via short-lived signed URL.
  storageKey  String?
  expiresAt   DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_export_requests")
}
