  viewerId String   @db.Uuid
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([storyId, viewedAt])
  @@map("story_views")
}

model StoryReaction {
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@map("story_reactions")
}

model Highlight {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @db.Uuid
  title        String
  coverMediaId String?  @db.Uuid
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cover MediaAsset?     @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  items HighlightItem[]

  @@index([ownerId, position])
  @@map("highlights")
}

model HighlightItem {
  highlightId String   @db.Uuid
  storyId     String   @db.Uuid
  position    Int
  addedAt     DateTime @default(now())

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([highlightId, storyId])
  @@map("highlight_items")
}

// -----------------------------------------------------------------------------
// MESSAGING
// -----------------------------------------------------------------------------
// Two storage modes per conversation:
//   * isE2ee = false → server-readable `body` (community channels, groups that
//     opt out, message requests before acceptance). TLS + encryption at rest.
//   * isE2ee = true  → `body` is null; per-recipient-device ciphertext lives in
//     MessageEnvelope (Signal Protocol). Server only routes opaque bytes.
// Typing indicators and presence are Redis/WebSocket only, never persisted.
// -----------------------------------------------------------------------------

model Conversation {
  id            String           @id @default(uuid(7)) @db.Uuid
  type          ConversationType
  title         String?
  avatarMediaId String?          @db.Uuid
  isE2ee        Boolean          @default(false)
  /// For DIRECT: deterministic "minUserId:maxUserId" to prevent duplicates.
  directKey     String?          @unique
  communityId   String?          @db.Uuid
  createdById   String?          @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  avatar    MediaAsset?          @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)
  community Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([communityId])
  @@map("conversations")
}

model ConversationMember {
  conversationId    String     @db.Uuid
  userId            String     @db.Uuid
  role              MemberRole @default(MEMBER)
  /// Message request (DM from someone you don't follow) until accepted.
  isRequest         Boolean    @default(false)
  joinedAt          DateTime   @default(now())
  leftAt            DateTime?
  /// Read-receipt watermark.
  lastReadMessageId String?    @db.Uuid
  lastReadAt        DateTime?
  mutedUntil        DateTime?
  isArchived        Boolean    @default(false)
  isPinned          Boolean    @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, isArchived])
  @@map("conversation_members")
}

model Message {
  id              String      @id @default(uuid(7)) @db.Uuid
  conversationId  String      @db.Uuid
  senderId        String?     @db.Uuid
  /// Client-generated idempotency key (retries over flaky networks).
  clientMessageId String
  type            MessageType
  body            String?
  mediaId         String?     @db.Uuid
  replyToId       String?     @db.Uuid
  forwardedFromId String?     @db.Uuid
  sharedPostId    String?     @db.Uuid
  storyId         String?     @db.Uuid
  sharedTrackId   String?     @db.Uuid
  metadata        Json?
  createdAt       DateTime    @default(now())
  editedAt        DateTime?
  /// "Delete for everyone": content wiped, tombstone kept for ordering.
  deletedAt       DateTime?

  conversation  Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User?             @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  media         MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  replyTo       Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]         @relation("MessageReply")
  forwardedFrom Message?          @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards      Message[]         @relation("MessageForward")
  sharedPost    Post?             @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  story         Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  sharedTrack   Track?            @relation(fields: [sharedTrackId], references: [id], onDelete: SetNull)
  reactions     MessageReaction[]
  envelopes     MessageEnvelope[]
  hiddenFor     MessageHidden[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reactions")
}

/// "Delete for me".
model MessageHidden {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_hidden")
}

/// Per-device E2EE identity (Signal Protocol). Public material only.
model E2eeDevice {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  /// Signal device id (1..n per user).
  deviceId              Int
  registrationId        Int
  identityKey           Bytes
  signedPreKeyId        Int
  signedPreKey          Bytes
  signedPreKeySignature Bytes
  /// Post-quantum (Kyber/ML-KEM) last-resort prekey for PQXDH.
  pqLastResortKeyId     Int?
  pqLastResortKey       Bytes?
  pqLastResortSignature Bytes?
  createdAt             DateTime  @default(now())
  revokedAt             DateTime?

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneTimeKeys E2eeOneTimePreKey[]
  envelopes   MessageEnvelope[]

  @@unique([userId, deviceId])
  @@map("e2ee_devices")
}

model E2eeOneTimePreKey {
  deviceRef String    @db.Uuid
  keyId     Int
  publicKey Bytes
  isPq      Boolean   @default(false)
  signature Bytes?
  /// Handed out exactly once (SELECT … FOR UPDATE SKIP LOCKED), then deleted.
  claimedAt DateTime?

  device E2eeDevice @relation(fields: [deviceRef], references: [id], onDelete: Cascade)

  @@id([deviceRef, keyId, isPq])
  @@index([deviceRef, claimedAt])
  @@map("e2ee_one_time_prekeys")
}

/// Opaque ciphertext for one recipient device. Deleted after delivery ack.
model MessageEnvelope {
  messageId         String    @db.Uuid
  recipientDeviceId String    @db.Uuid
  /// Signal message type (PreKeySignalMessage / SignalMessage / SenderKey…).
  envelopeType      Int
  ciphertext        Bytes
  deliveredAt       DateTime?

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device  E2eeDevice @relation(fields: [recipientDeviceId], references: [id], onDelete: Cascade)

  @@id([messageId, recipientDeviceId])
  @@index([recipientDeviceId, deliveredAt])
  @@map("message_envelopes")
}

