// =============================================================================
// VYBORA — PostgreSQL schema (Prisma 7)
// =============================================================================
// Conventions
//   * Primary keys: UUIDv7 (time-ordered → index-friendly, safe to expose).
//   * Money: integer minor units (paise/cents) + ISO-4217 currency. Never floats.
//   * Soft delete: `deletedAt` on user-generated content; hard purge by jobs.
//   * Counters (likeCount, followerCount…) are denormalized and maintained by
//     the API/worker; source-of-truth rows always exist for recount jobs.
//   * Table names are snake_case plural via @@map; columns are camelCase.
//   * High-volume ephemeral data (presence, typing, impressions, rate limits,
//     trending windows) lives in Redis / analytics, NOT in this schema.
// See documentation/database/SCHEMA.md for the ERD and rationale.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

