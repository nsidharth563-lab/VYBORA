model CommunityEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  communityId String    @db.Uuid
  createdById String    @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  timezone    String
  location    String?
  onlineUrl   String?
  createdAt   DateTime  @default(now())
