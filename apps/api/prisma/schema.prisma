  audience     StoryAudience @default(FOLLOWERS)
  allowReplies Boolean       @default(true)
  status       ContentStatus @default(ACTIVE)
  viewCount    Int           @default(0)
  /// createdAt + 24h. Expired stories remain for the author's archive/highlights.
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  author         User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media          MediaAsset?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
