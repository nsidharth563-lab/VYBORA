# ---------------------------------------------------------------------------
# VYBORA API — copy to apps/api/.env and fill in. NEVER commit real values.
# Values below match infrastructure/docker/docker-compose.yml for local dev.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Admin dashboard (3000) and Expo web (8081)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database / cache ---
DATABASE_URL="postgresql://vybora:vybora@localhost:5432/vybora?schema=public"
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Leave blank locally (insecure dev defaults are used). REQUIRED in production:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=
IP_HASH_SECRET=
# Reject passwords found in public breaches (Have I Been Pwned range API; fail-open).
PWNED_PASSWORD_CHECK=true
ACCOUNT_DELETION_GRACE_DAYS=30
# Comma-separated Google OAuth client ids (web, iOS, Android) accepted as ID-token audiences.
GOOGLE_OAUTH_CLIENT_IDS=
# Apple: bundle id (native) and/or Services ID (web). Leave empty to disable Apple sign-in.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# --- Email / SMS ---
# smtp (Mailpit locally on 1025; Amazon SES SMTP in production) | console (dev only: logs emails)
MAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="VYBORA <no-reply@vybora.local>"
# console (dev only: logs SMS) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sender number (E.164) or Messaging Service SID (MG...)
TWILIO_FROM=

# --- Object storage (moto S3 emulator locally via docker compose; S3 + CloudFront in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vybora
S3_SECRET_ACCESS_KEY=vybora-dev-secret
S3_BUCKET_UPLOADS=vybora-uploads
S3_BUCKET_MEDIA=vybora-media
S3_FORCE_PATH_STYLE=true
# URL that phones use for presigned uploads. Set to your computer's LAN IP when testing on a device,
# e.g. http://192.168.1.20:9000 (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
# Local dev only: create buckets and dev CORS on boot.
S3_CREATE_BUCKETS=true
CDN_BASE_URL=http://localhost:9000/vybora-media
# Process uploads inside the API process (dev). In production run `pnpm --filter @vybora/api worker`.
MEDIA_WORKER_INLINE=true
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# --- AI (server-side only; never shipped to the app) ---
AI_PROVIDER=openai                  # openai | mock
OPENAI_API_KEY=
AI_DAILY_CREDITS_FREE=50

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=2000               # 20% platform fee, basis points

# --- Push ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Music (licensed provider) ---
MUSIC_PROVIDER=mock                 # mock | <licensed provider adapter>
MUSIC_PROVIDER_API_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=debug
