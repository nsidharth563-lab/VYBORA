{
  "name": "@vybora/api",
  "version": "0.0.0",
  "private": true,
  "description": "VYBORA backend — NestJS modular monolith (REST + WebSocket) and background workers. Application code lands in Phase 3 (Auth).",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:db": "node --import tsx --test test/*.test.ts",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "^11.16.0",
    "@vybora/shared": "workspace:*",
    "@vybora/types": "workspace:*",
    "blurhash": "^2.0.5",
    "bullmq": "^6.7.8",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@vybora/config": "workspace:*",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
